rules_version = '2';

// HomeLedger security rules.
//
// Principles:
// - Nothing is readable without signing in, and nothing is listed without a query the rules can prove safe.
// - Access is per property: `properties/{id}.members[uid].role`. The record owner (`ownerUid`) and the
//   team roles (owner, co_owner, manager, agent) run the property; everyone else sees only what is shared.
// - People join only through an invitation they accept themselves.
// - Evidence, signatures and audit events are append-only. Completed inspections are frozen.
// - Times that matter (uploads, completion, signatures, audit) must equal the server's request.time.
//
// Keep `src/domain/roles.ts` in step with these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function propPath(pid) { return /databases/$(database)/documents/properties/$(pid); }
    function prop(pid) { return get(propPath(pid)).data; }
    function isMemberOf(p) { return signedIn() && uid() in p.memberIds; }
    function roleIn(p) { return p.members[uid()].role; }
    function isTeamOf(p) {
      return isMemberOf(p) && (p.ownerUid == uid() || roleIn(p) in ['owner', 'co_owner', 'manager', 'agent']);
    }
    function canInspectOf(p) { return isMemberOf(p) && (p.ownerUid == uid() || roleIn(p) != 'contractor'); }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function isString(v, max) { return v is string && v.size() <= max; }
    function optString(m, k, max) { return !(k in m) || m[k] == null || isString(m[k], max); }

    function invitePath(id) { return /databases/$(database)/documents/invitations/$(id); }
    function inviteUsable(inv) {
      return inv.status == 'pending'
        && inv.expiresAt > request.time
        && inv.invitedBy != uid()
        && (inv.get('email', null) == null
            || (request.auth.token.get('email', '').lower() == inv.email
                && request.auth.token.get('email_verified', false) == true));
    }

    // ---------- users ----------

    match /users/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && isString(request.resource.data.displayName, 100)
        && request.resource.data.intents is list
        && request.resource.data.intents.hasOnly(['landlord', 'tenant']);
    }

    match /deletionRequests/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'requested';
    }

    // ---------- properties ----------

    function validPropertyFields(d) {
      return isString(d.name, 120) && d.name.size() > 0
        && d.type in ['apartment', 'house', 'townhouse', 'room', 'commercial', 'multi_unit', 'other']
        && d.address is map && isString(d.address.line1, 200) && isString(d.address.city, 100)
        && d.recordKind in ['landlord', 'tenant']
        && isString(d.marketId, 8) && isString(d.currency, 3)
        && d.archived is bool
        && optString(d, 'notes', 5000) && optString(d, 'unitNumber', 40)
        && optString(d, 'buildingName', 120) && optString(d, 'portfolio', 120);
    }

    match /properties/{pid} {
      allow read: if isMemberOf(resource.data);

      allow create: if signedIn()
        && validPropertyFields(request.resource.data)
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && request.resource.data.members[uid()].role
            == (request.resource.data.recordKind == 'landlord' ? 'owner' : 'tenant')
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time;

      allow update: if editingDetails() || joiningWithInvite() || leaving() || removingMember();
      allow delete: if false; // archive instead, so shared records stay intact

      function editingDetails() {
        return isTeamOf(resource.data)
          && validPropertyFields(request.resource.data)
          && unchanged(['ownerUid', 'recordKind', 'createdAt', 'members', 'memberIds'])
          // only the record owner archives
          && (request.resource.data.archived == resource.data.archived || resource.data.ownerUid == uid());
      }

      function joiningWithInvite() {
        let before = resource.data;
        let after = request.resource.data;
        let entry = after.members[uid()];
        let inv = get(invitePath(entry.inviteId)).data;
        return signedIn()
          && !(uid() in before.memberIds)
          && onlyChanged(['members', 'memberIds', 'updatedAt'])
          && after.memberIds.size() == before.memberIds.size() + 1
          && after.memberIds.hasAll(before.memberIds) && uid() in after.memberIds
          && after.members.diff(before.members).affectedKeys() == [uid()].toSet()
          && entry.keys().hasOnly(['role', 'displayName', 'email', 'joinedAt', 'inviteId'])
          && isString(entry.displayName, 100)
          && entry.joinedAt == request.time
          && inv.propertyId == pid && entry.role == inv.role && inviteUsable(inv)
          && getAfter(invitePath(entry.inviteId)).data.acceptedBy == uid();
      }

      function leaving() {
        let before = resource.data;
        let after = request.resource.data;
        return isMemberOf(before) && before.ownerUid != uid()
          && onlyChanged(['members', 'memberIds', 'updatedAt'])
          && after.memberIds.toSet() == before.memberIds.toSet().difference([uid()].toSet())
          && after.members.diff(before.members).affectedKeys() == [uid()].toSet()
          && !(uid() in after.members);
      }

      function removingMember() {
        let before = resource.data;
        let after = request.resource.data;
        let removed = before.memberIds.toSet().difference(after.memberIds.toSet());
        return before.ownerUid == uid()
          && onlyChanged(['members', 'memberIds', 'updatedAt'])
          && removed.size() == 1 && !(uid() in removed)
          && after.memberIds.toSet() == before.memberIds.toSet().difference(removed)
          && after.members.diff(before.members).affectedKeys() == removed
          && after.members.keys().toSet() == after.memberIds.toSet();
      }

      // Ownership, purchase, bond, insurance: the owner's team only.
      match /private/{docId} {
        allow read, write: if isTeamOf(prop(pid));
      }

      // ---------- tenancies ----------

      match /tenancies/{tid} {
        allow read: if isTeamOf(prop(pid)) || (signedIn() && uid() in resource.data.partyIds);

        allow create: if isTeamOf(prop(pid))
          && validTenancy(request.resource.data)
          && request.resource.data.partyIds == []
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time;

        allow update: if (isTeamOf(prop(pid))
            && validTenancy(request.resource.data)
            && unchanged(['createdBy', 'createdAt', 'propertyId'])
            && resource.data.partyIds.toSet().hasAll(request.resource.data.partyIds))
          || joiningTenancy();

        allow delete: if false;

        function validTenancy(d) {
          return d.propertyId == pid && isString(d.tenantName, 120) && d.tenantName.size() > 0
            && d.startDate is string && d.monthlyRent is int && d.monthlyRent >= 0
            && d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31
            && d.escalation is map && d.adjustments is list && d.partyIds is list
            && isString(d.currency, 3);
        }

        function joiningTenancy() {
          let entry = getAfter(propPath(pid)).data.members[uid()];
          let inv = get(invitePath(entry.inviteId)).data;
          return signedIn()
            && onlyChanged(['partyIds', 'updatedAt'])
            && request.resource.data.partyIds.toSet() == resource.data.partyIds.toSet().union([uid()].toSet())
            && !(uid() in resource.data.partyIds)
            && inv.propertyId == pid && inv.get('tenancyId', null) == tid && inviteUsable(inv);
        }
      }

      // ---------- inspections ----------

      match /inspections/{iid} {
        function canRead(d) {
          return signedIn() && (uid() in d.participantIds || (d.teamVisible == true && isTeamOf(prop(pid))));
        }
        function canEditDraft(d) {
          return signedIn() && (uid() in d.editorIds || (d.createdByTeam == true && isTeamOf(prop(pid))));
        }
        // Sharing only ever widens access, and only to current members of the property.
        function sharingOk() {
          let before = resource.data;
          let after = request.resource.data;
          return after.participantIds.toSet().hasAll(before.participantIds)
            && after.participantIds.toSet().difference(before.participantIds.toSet()).hasOnly(prop(pid).memberIds)
            && (after.teamVisible == before.teamVisible || after.teamVisible == true);
        }
        function frozenKeys() {
          return ['propertyId', 'createdBy', 'createdByName', 'createdByRole', 'createdByTeam', 'createdAt',
                  'editorIds', 'templateSet', 'completedAt', 'completedBy', 'contentHash'];
        }

        allow read: if canRead(resource.data);

        allow create: if canInspectOf(prop(pid))
          && request.resource.data.propertyId == pid
          && request.resource.data.status == 'draft'
          && request.resource.data.type in ['ingoing', 'routine', 'maintenance', 'outgoing', 'custom']
          && isString(request.resource.data.title, 200)
          && request.resource.data.rooms is map
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdByRole == roleIn(prop(pid))
          && request.resource.data.createdByTeam == isTeamOf(prop(pid))
          && (request.resource.data.createdByTeam == false || request.resource.data.teamVisible == true)
          && request.resource.data.teamVisible is bool
          && request.resource.data.editorIds == [uid()]
          && uid() in request.resource.data.participantIds
          && request.resource.data.participantIds.hasOnly(prop(pid).memberIds)
          && request.resource.data.createdAt == request.time
          && !('completedAt' in request.resource.data) && !('contentHash' in request.resource.data);

        allow update: if editingDraft() || completing() || sharingCompleted() || voiding();
        allow delete: if false;

        function editingDraft() {
          return resource.data.status == 'draft' && request.resource.data.status == 'draft'
            && canEditDraft(resource.data) && unchanged(frozenKeys()) && sharingOk();
        }

        function completing() {
          let d = request.resource.data;
          return resource.data.status == 'draft' && d.status == 'completed'
            && canEditDraft(resource.data)
            && unchanged(['propertyId', 'createdBy', 'createdByName', 'createdByRole', 'createdByTeam',
                          'createdAt', 'editorIds', 'templateSet'])
            && sharingOk()
            && d.completedBy == uid() && d.completedAt == request.time
            && d.contentHash is string && d.contentHash.matches('^[0-9a-f]{64}$')
            && existsAfter(/databases/$(database)/documents/properties/$(pid)/audit/$('complete_' + iid));
        }

        function sharingCompleted() {
          return resource.data.status == 'completed' && canRead(resource.data)
            && onlyChanged(['participantIds', 'teamVisible', 'updatedAt']) && sharingOk();
        }

        function voiding() {
          return resource.data.status in ['draft', 'completed'] && request.resource.data.status == 'void'
            && (resource.data.createdBy == uid() || (resource.data.createdByTeam == true && isTeamOf(prop(pid))))
            && onlyChanged(['status', 'voidReason', 'updatedAt'])
            && isString(request.resource.data.voidReason, 500) && request.resource.data.voidReason.size() > 0;
        }

        // One photo or video. Never updated or deleted: corrections are new evidence.
        match /evidence/{eid} {
          function parent() { return get(/databases/$(database)/documents/properties/$(pid)/inspections/$(iid)).data; }
          allow read: if canRead(parent());
          allow create: if signedIn()
            && request.resource.data.id == eid
            && request.resource.data.uploadedBy == uid()
            && request.resource.data.uploadedAt == request.time
            && request.resource.data.sha256 is string && request.resource.data.sha256.matches('^[0-9a-f]{64}$')
            && request.resource.data.size is int && request.resource.data.size > 0
            && request.resource.data.storagePath.matches('^properties/' + pid + '/inspections/' + iid + '/' + eid + '/.+')
            && request.resource.data.kind in ['photo', 'video']
            && ((parent().status == 'draft' && canEditDraft(parent()) && request.resource.data.addendum == false)
                || (parent().status == 'completed' && canRead(parent()) && request.resource.data.addendum == true));
          allow update, delete: if false;
        }

        // Document id is the signer's uid: one signature per person, written once, by them.
        match /signatures/{signerId} {
          function parent() { return get(/databases/$(database)/documents/properties/$(pid)/inspections/$(iid)).data; }
          allow read: if canRead(parent());
          allow create: if signedIn() && uid() == signerId
            && parent().status == 'completed' && canRead(parent())
            && request.resource.data.uid == uid()
            && request.resource.data.signedAt == request.time
            && request.resource.data.contentHash == parent().contentHash
            && request.resource.data.acknowledgedReceipt == true
            && request.resource.data.agreement in ['agree', 'disagree', 'partial']
            && request.resource.data.role == roleIn(prop(pid))
            && isString(request.resource.data.comment, 5000)
            && isString(request.resource.data.signatureImage, 300000)
            && request.resource.data.signatureImage.matches('^data:image/png;base64,.*')
            && existsAfter(/databases/$(database)/documents/properties/$(pid)/audit/$('sign_' + iid + '_' + uid()));
          allow update, delete: if false;
        }
      }

      // ---------- audit ----------

      match /audit/{eventId} {
        allow read: if isTeamOf(prop(pid)) || (signedIn() && resource.data.actorUid == uid());
        allow create: if isMemberOf(prop(pid))
          && request.resource.data.actorUid == uid()
          && request.resource.data.at == request.time
          && isString(request.resource.data.action, 60)
          && isString(request.resource.data.summary, 500)
          && (!eventId.matches('^complete_.*')
              || (request.resource.data.action == 'inspection.completed'
                  && getAfter(/databases/$(database)/documents/properties/$(pid)/inspections/$(eventId.split('_')[1])).data.status == 'completed'))
          && (!eventId.matches('^sign_.*')
              || (request.resource.data.action == 'inspection.signed'
                  && existsAfter(/databases/$(database)/documents/properties/$(pid)/inspections/$(eventId.split('_')[1])/signatures/$(uid()))));
        allow update, delete: if false;
      }
    }

    // ---------- collection group queries (a person's history across properties) ----------

    match /{path=**}/inspections/{iid} {
      allow read: if signedIn() && uid() in resource.data.participantIds;
    }
    match /{path=**}/tenancies/{tid} {
      allow read: if signedIn() && uid() in resource.data.partyIds;
    }

    // ---------- invitations ----------

    match /invitations/{token} {
      // The token is the secret: anyone signed in who has the link may open it, but not list others.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.invitedBy == uid();

      allow create: if signedIn()
        && isTeamOf(prop(request.resource.data.propertyId))
        && request.resource.data.id == token
        && token.size() >= 32
        && request.resource.data.invitedBy == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd')
        && (request.resource.data.get('email', null) == null
            || (request.resource.data.email is string && request.resource.data.email == request.resource.data.email.lower()))
        && validInviteRole(prop(request.resource.data.propertyId).recordKind, request.resource.data.role)
        && (request.resource.data.get('tenancyId', null) == null
            || exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)/tenancies/$(request.resource.data.tenancyId)));

      allow update: if revoking() || accepting();
      allow delete: if false;

      function validInviteRole(kind, role) {
        return (kind == 'landlord' && role in ['co_owner', 'manager', 'agent', 'tenant', 'co_tenant', 'inspector', 'contractor'])
          || (kind == 'tenant' && role in ['landlord', 'agent', 'co_tenant']);
      }

      function revoking() {
        return resource.data.status == 'pending' && request.resource.data.status == 'revoked'
          && (resource.data.invitedBy == uid() || isTeamOf(prop(resource.data.propertyId)))
          && onlyChanged(['status', 'revokedAt']);
      }

      function accepting() {
        let after = getAfter(propPath(resource.data.propertyId)).data;
        return inviteUsable(resource.data)
          && onlyChanged(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == uid()
          && request.resource.data.acceptedAt == request.time
          && uid() in after.memberIds
          && after.members[uid()].inviteId == token;
      }
    }
  }
}
